import lightkurve as lk
import matplotlib.pyplot as plt
import pandas as pd
from wotan import flatten

# === STEP 1: Download and clean PDCSAP_FLUX light curves ===
search_result = lk.search_lightcurve("TOI 2155", mission="TESS", author="SPOC")
lc_collection = search_result.download_all()

cleaned_lcs = []
for lc in lc_collection:
    lc_pdcsap = lc.PDCSAP_FLUX
    if lc_pdcsap is not None:
        lc_clean = lc_pdcsap.remove_nans()
        cleaned_lcs.append(lc_clean)

# === STEP 2: Stitch all sectors together ===
lc_stitched = lk.LightCurveCollection(cleaned_lcs).stitch()
time = lc_stitched.time.value + 2457000  # Convert to full BJD
flux = lc_stitched.flux.value
flux_err = lc_stitched.flux_err.value


# === STEP 3: Detrend with Tukey's biweight ===
flattened_flux = flatten(
    time,
    flux,
    method='biweight',
    window_length=0.5
    
    
    
    
)

# === STEP 4: Plot raw vs detrended ===
plt.figure(figsize=(10, 5))
plt.plot(time, flux, '.', alpha=0.3, label='Raw (PDCSAP_FLUX)', color='C0')

plt.plot(time, flattened_flux, '.', alpha=0.6, label='Detrended (Flattened)', color='C1')
plt.xlabel("Time (BJD)")
plt.ylabel("Flux")


plt.title("TOI 2155 - Raw vs Trend vs Detrended (Tukey Biweight)")
plt.legend()
plt.tight_layout()
plt.show()

# === STEP 5: Save to CSV ===
df = pd.DataFrame({
    '#time': time,
    'flux': flattened_flux,
    'flux_err': flux_err,
 

})
df.to_csv("TESS.csv", index=False)
print(" Saved to TESS.csv")
